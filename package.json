{
  "name": "@portabletext/plugin-sdk-value",
  "version": "8.1.20",
  "description": "Connect a Portable Text Editor with a Sanity document using the SDK",
  "keywords": [
    "@sanity/sdk",
    "@sanity/sdk-react",
    "plugin",
    "portabletext",
    "sdk",
    "sync",
    "value"
  ],
  "homepage": "https://portabletext.org",
  "bugs": {
    "url": "https://github.com/portabletext/plugin-sdk-value/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/portabletext/plugin-sdk-value.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pkg-utils build --strict --check",
    "check:format": "oxfmt --check .",
    "check:knip": "NODE_OPTIONS=\"$NODE_OPTIONS --conditions=source\" knip",
    "check:lint": "oxlint",
    "check:types": "tsc",
    "check:types:watch": "tsc --watch",
    "clean": "del dist && del node_modules",
    "dev": "pkg-utils watch",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "prepublishOnly": "pnpm build",
    "release": "pnpm build && changeset publish",
    "test:browser": "vitest --run --project browser",
    "test:browser:chromium": "vitest --run --project \"browser (chromium)\"",
    "test:browser:chromium:watch": "vitest --project \"browser (chromium)\"",
    "test:browser:firefox": "vitest --run --project \"browser (firefox)\"",
    "test:browser:firefox:watch": "vitest --project \"browser (firefox)\"",
    "test:browser:webkit": "vitest --run --project \"browser (webkit)\"",
    "test:browser:webkit:watch": "vitest --project \"browser (webkit)\"",
    "test:unit": "vitest --run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@portabletext/patches": "^3.0.4",
    "@sanity/diff-match-patch": "^3.2.1",
    "@sanity/diff-patch": "^6.0.0",
    "@sanity/json-match": "^1.0.5",
    "@xstate/react": "^6.1.0",
    "obug": "^3.0.0",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.62.1",
    "@portabletext/editor": "^8.2.12",
    "@portabletext/schema": "^3.1.0",
    "@portabletext/test": "^2.1.3",
    "@rexxars/bundle-stats": "^2.0.1",
    "@sanity/pkg-utils": "^12.3.0",
    "@sanity/sdk-react": "^3.11.0",
    "@sanity/tsconfig": "^2.2.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "del-cli": "^6.0.0",
    "jsdom": "^27.2.0",
    "knip": "6.0.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.79.0",
    "pkg-pr-new": "^0.0.88",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "@portabletext/editor": "^8.2.12",
    "@sanity/sdk-react": "^2.20.1 || ^3",
    "react": "^19.2",
    "react-dom": "^19.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.25.0"
}
